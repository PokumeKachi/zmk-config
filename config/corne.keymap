#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&hold_tap {
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <200>;
    require-prior-idle-ms = <150>;
};

&hm {
    label = "HOME_ROW_MODS";
    #binding-cells = <2>;
    bindings = <&kp>, <&kp>;
    hold-tap = <&hold_tap>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        // ================================================================
        // BASE LAYER – QWERTY with Home Row Mods
        //   Left:  A=Ctrl, S=Shift, D=Alt, F=GUI
        //   Right: J=Ctrl, K=Shift, L=Alt, ;=GUI
        // ================================================================
        default_layer {
            bindings = <
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T       &kp Y &kp U &kp I &kp O &kp P &kp LBKT
                &hm LCTRL A &hm LSHIFT S &hm LALT D &hm LGUI F &kp G       &kp H &hm LCTRL J &hm LSHIFT K &hm LALT L &hm LGUI SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B       &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp ESC
                                  &kp LGUI &mo 1 &kp SPACE     &kp BSPC &mo 2 &kp RET
            >;
        };

        // ================================================================
        // LOWER LAYER – Numbers, Bluetooth, Arrows
        // ================================================================
        lower_layer {
            bindings = <
                &kp TAB    &kp N1 &kp N2 &kp N3 &kp N4 &kp N5       &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC
                &trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
                &kp LSHFT  &trans &trans &trans &trans &trans       &trans &trans &trans &trans &trans &trans
                                  &kp LGUI &trans &kp SPACE         &kp RET &trans &kp RALT
            >;
        };

        // ================================================================
        // RAISE LAYER – Symbols
        // ================================================================
        raise_layer {
            bindings = <
                &kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
                &kp LCTRL &kp LBKT &kp RBKT &kp LBRC &kp RBRC &trans     &kp MINUS &kp EQUAL &kp UNDER &kp PLUS &kp BSLH &kp GRAVE
                &kp LSHFT &trans &trans &trans &trans &trans            &trans &trans &trans &trans   &kp PIPE &kp TILDE
                                  &kp LGUI &trans &kp SPACE             &kp RET &trans &kp RALT
            >;
        };

        // ================================================================
        // FUNCTION LAYER – F-keys & Media
        // ================================================================
        function_layer {
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6       &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &trans &trans &trans &trans &trans &trans       &kp C_VOLUME_DOWN &kp C_VOLUME_UP &kp C_MUTE &kp C_PLAY_PAUSE &trans &trans
                &trans &trans &trans &trans &trans &trans       &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans         &trans &trans &trans
            >;
        };
    };
};
